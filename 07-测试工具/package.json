{
  "name": "hanxong-test-tools",
  "private": true,
  "description": "汉客松 07-测试工具 的依赖清单（Node 从文件所在目录向上找 node_modules，所以必须装在这一层或包根）",
  "scripts": {
    "compile": "node compile_sol.js ../03-合约/RainDeliveryInsurance.sol",
    "compile:v2": "node compile_sol.js ../03-合约/RainDeliveryInsuranceV2.sol --via-ir",
    "sync-abi": "node sync_abi.js",
    "build": "npm run compile && npm run sync-abi",
    "e2e": "node e2e_contract.js",
    "e2e:v2": "node e2e_v2.js",
    "check-canonical": "node check-canonical.js",
    "check-ai": "node check-ai.js",
    "check-ui": "node check-ui.js",
    "check-feed-verify": "node check-feed-verify.js",
    "ai:collect": "node ../04-脚本/ai-collect.js",
    "ai:judge": "node ../04-脚本/ai-judge.js",
    "ai:submit": "node ../04-脚本/submit-judgement.js",
    "test": "npm run check-canonical && npm run check-ai && npm run check-ui && npm run check-feed-verify && npm run e2e && npm run e2e:v2"
  },
  "dependencies": {
    "ethers": "^6.13.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.26"
  }
}
